{
  "name": "crosscord",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "oxlint",
    "format": "dprint fmt",
    "compile": "bun run src/builder/index.ts -c -p -l 10",
    "dev": "PORT=8765 bun --watch run -e .env src/server/index.ts",
    "start": "NODE_ENV=production PORT=8765 bun run -e .env src/server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8765"
  },
  "author": "taskylizard",
  "license": "MIT",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@zip.js/zip.js": "^2.8.2",
    "adm-zip": "^0.5.16",
    "hono": "^4.9.8",
    "lightningcss": "^1.30.1",
    "p-limit": "^7.1.1",
    "purgecss": "^7.0.2",
    "rolldown": "^1.0.0-beta.38",
    "sharp": "^0.34.4",
    "tinyglobby": "^0.2.15",
    "unplugin-lightningcss": "0.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "^1.2.22",
    "dprint": "^0.50.2",
    "lefthook": "1.13.1",
    "oxlint": "^1.16.0",
    "typescript": "~5.8.0"
  }
}
